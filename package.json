{
  "name": "learnbycode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "pnpm render && astro dev --host 0.0.0.0",
    "check": "astro check && tsc --project tsconfig.interactions.json --noEmit",
    "render": "node scripts/render-explainers.mjs",
    "render:review": "node scripts/render-explainers.mjs --review",
    "build": "pnpm render && astro build && node scripts/check-site.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "verify": "pnpm check && pnpm build"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "astro": "6.4.8",
    "esbuild": "0.28.2",
    "node-html-parser": "9.0.1",
    "typescript": "5.9.3",
    "visual-explainer": "0.15.0",
    "playwright-core": "1.65.0",
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@11.5.2"
}
