---
import type { CollectionEntry } from 'astro:content'
import SiteLayout from '../layouts/SiteLayout.astro'
import TopicList from './TopicList.astro'
import { localizedPath } from '../lib/paths'
import { ui, type Language } from '../lib/i18n'
interface Props { language: Language; kind: 'home' | 'topics' | 'topic' | 'notFound'; topic?: CollectionEntry<'topics'> }
const { language, kind, topic } = Astro.props
const t = ui[language]
const title = kind === 'home' ? t.homeTitle : kind === 'topics' ? t.topics : kind === 'topic' && topic ? topic.data.title[language] : t.notFound
const description = kind === 'home' ? t.homeDescription : kind === 'topics' ? t.topicsDescription : kind === 'topic' && topic ? topic.data.description[language] : t.notFoundDescription
const contentPath = kind === 'home' ? '' : kind === 'topics' ? 'topics/' : kind === 'topic' && topic ? `topics/${topic.id}/` : '404.html'
---
<SiteLayout {language} {title} {description} {contentPath} noindex={kind === 'notFound'}>
  {kind === 'home' && <>
    <section class="intro"><p class="eyebrow">{t.eyebrow}</p><h1>{t.heading1}<br />{t.heading2}</h1><p class="lead">{t.lead}</p><a class="text-link" href={localizedPath(language, 'explainers/superagent/routing/')}>{t.start} <span aria-hidden="true">→</span></a></section>
    <section class="home-figure" aria-label={t.learning}><span>{t.choose}</span><span aria-hidden="true">→</span><span>{t.observe}</span><span aria-hidden="true">→</span><span>{t.inspect}</span></section>
    <section class="section-block" aria-labelledby="topics-title"><div class="section-label"><p class="eyebrow">{t.begin}</p><h2 id="topics-title">{t.exploring}</h2></div><TopicList {language} /></section>
  </>}
  {kind === 'topics' && <><section class="intro compact"><p class="eyebrow">{t.topics}</p><h1>{t.topicsHeading1}<br />{t.topicsHeading2}</h1><p class="lead">{t.topicsLead}</p></section><TopicList {language} /></>}
  {kind === 'topic' && topic && <>
    <section class="intro compact"><a class="back" href={localizedPath(language, 'topics/')}>{t.back}</a><p class="eyebrow">{topic.data.tags[language].join(' / ')}</p><h1>{topic.data.title[language]}</h1><p class="lead">{topic.data.subtitle[language]}{language === 'zh' ? '。' : '. '}{topic.data.description[language]}</p></section>
    <ol class="lesson-list">{topic.data.lessons.map((lesson, index) => <li><span class="lesson-index">{String(index + 1).padStart(2, '0')}</span><div><span class="chip">{lesson.status === 'published' ? t.published : t.planned}</span><h2>{lesson.status === 'published' ? <a href={localizedPath(language, `explainers/${topic.id}/${lesson.slug}/`)}>{lesson.title[language]} <span aria-hidden="true">↗</span></a> : lesson.title[language]}</h2><p>{lesson.description[language]}</p>{lesson.status === 'published' && <small>{t.about} {lesson.minutes} {t.minutes} · {t.verified} {lesson.verifiedAt}</small>}</div></li>)}</ol>
    <p class="note">{t.boundary}</p>
  </>}
  {kind === 'notFound' && <section class="intro"><p class="eyebrow">404 / {t.notFound}</p><h1>{t.notFoundHeading}</h1><p class="lead">{t.notFoundLead}</p><a class="text-link" href={localizedPath(language, 'topics/')}>{t.return} →</a></section>}
</SiteLayout>
